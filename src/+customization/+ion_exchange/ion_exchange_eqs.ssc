component ion_exchange_eqs
% Ion Exchange EQs (SS)
% Models reversible uptake and release of the single tracked solute x by
% a resin with fixed capacity.

nodes
    F = customization.solution.solution; % F
end

inputs (ExternalAccess = none)
    x = {0, 'kg/m^3'};   % x concentration
end

outputs (ExternalAccess = none)
    mdot_x = {0, 'kg/s'};   % x mass flow into the solution
end

parameters
    q_max = {1, 'mol'};             % Maximum resin capacity
    k_ads = {1, 'l/(mol*s)'};       % x adsorption rate constant
    k_des = {0, '1/s'};             % x desorption rate constant
    theta_x0 = {0, '1'};            % Initial fractional x occupancy
end

annotations
    UILayout = [
        UIGroup('Transport', q_max, k_ads, k_des)
        UIGroup('InitialConditions', theta_x0)
    ];
end

annotations
    [x, mdot_x] : ExternalAccess = modify;
    theta_x0 : ExternalAccess = modify;
end

intermediates (ExternalAccess = none)
    C_x = x / F.M;
    r_ads = k_ads * C_x * (1 - theta_x) * q_max;
    r_des = k_des * theta_x * q_max;
end

variables (ExternalAccess = observe)
    theta_x = {value = theta_x0, priority = priority.high};
end

equations
    assert(q_max > 0)
    assert(theta_x >= 0)
    assert(theta_x <= 1)

    mdot_x == (r_des - r_ads) * F.M;
    der(theta_x) == (r_ads - r_des) / q_max;
end

end
