component delayed_switch
% Delayed Switch (SS)
% A hysteretic, two-port solution-domain valve. The CLOSED state uses the
% leakage area and the OPEN state uses the maximum opening area.

nodes
    A = customization.solution.solution; % A:left
    B = customization.solution.solution; % B:right
end

inputs
    u = {0, '1'};
end

outputs
    y = {0, '1'};
end

parameters
    min_area = {1e-10, 'm^2'}; % Leakage area in the CLOSED state
    max_area = {1e-4, 'm^2'};  % Opening area in the OPEN state
    area = {0.01, 'm^2'};      % Cross-sectional area at ports A and B
    Cd = {0.64, '1'};          % Discharge coefficient
    Re_c = {150, '1'};         % Critical Reynolds number
    pressure_recovery = simscape.enum.onoff.on;
    custom_ports = false;
    T_closed = {0.5, '1'};     % Upper threshold
    T_open = {0, '1'};         % Lower threshold
    InitMode = customization.function.switching.open;
end

parameters (ExternalAccess = none)
    length_A = {1e-3, 'm'};
    length_B = {1e-3, 'm'};
end

equations
    assert(min_area > 0)
    assert(max_area > min_area)
    assert(max_area < area)
    assert(Cd > 0)
    assert(Re_c > 0)
    assert(T_closed >= T_open, 'Upper threshold must be higher than Lower threshold')
end

components (ExternalAccess = none)
    controller = customization.solution.elements.delayed_switch_controller(...
        min_area = min_area,...
        max_area = max_area,...
        T_closed = T_closed,...
        T_open = T_open,...
        InitMode = InitMode);
end
components (ExternalAccess = observe)
    valve = customization.solution.elements.local_restriction(...
        restriction_type = foundation.enum.restriction_type.variable,...
        min_area = min_area,...
        max_area = max_area,...
        area = area,...
        Cd = Cd,...
        Re_c = Re_c,...
        pressure_recovery = pressure_recovery,...
        custom_ports = custom_ports,...
        length_A = length_A,...
        length_B = length_B);
end

connections
    connect(A, valve.A)
    connect(B, valve.B)
    connect(u, controller.u)
    connect(controller.y, y)
    connect(controller.area_cmd, valve.area_in)
end

end
